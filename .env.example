# Kök .env: API ve scraper ikisi de okur. Boş anahtarları elle üretin (≥32 karakter).

# Groq Cloud API key — https://console.groq.com/keys
GROQ_API_KEY=

# Scraper → API (/api/v1/scraper/**). En az 32 karakter.
SCRAPER_API_KEY=
# API → scraper (/routes/bus, /lodging/search, /jobs). En az 32 karakter, yukarıdakinden farklı.
SCRAPER_TRIGGER_KEY=

# Access JWT imzası. En az 32 bayt.
JWT_SECRET=
# Access ve refresh ömrü. Spring süre biçimi: 15m, 12h, 30d. Boşsa 15 dakika ve 30 gün.
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d
# İkisi de doluysa ve e-posta yoksa açılışta bir admin yazılır.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# İsteğe bağlı
# POSTGRES_PASSWORD=          # yalnız yeni volume'da uygulanır
# API_BIND_ADDRESS=0.0.0.0    # telefondan LAN ile denemek için
# CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
