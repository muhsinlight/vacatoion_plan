# Üretim örneği: bu dosyayı kopyalayıp ortam değişkenleriyle besleyin.
# Zorunlu: POSTGRES_PASSWORD, JWT_SECRET, SCRAPER_API_KEY, SCRAPER_TRIGGER_KEY

spring:
  datasource:
    url: jdbc:postgresql://${POSTGRES_HOST:localhost}:${POSTGRES_PORT:5432}/${POSTGRES_DB:vacation_plan}
    username: ${POSTGRES_USER:vacation}
    password: ${POSTGRES_PASSWORD}
  docker:
    compose:
      enabled: false

vacation:
  auth:
    jwt-secret: ${JWT_SECRET}
    admin-email: ${ADMIN_EMAIL:}
    admin-password: ${ADMIN_PASSWORD:}
  scraper-api-key: ${SCRAPER_API_KEY}
  scraper-trigger-key: ${SCRAPER_TRIGGER_KEY}
  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS}

management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics
  endpoint:
    health:
      show-details: when_authorized
